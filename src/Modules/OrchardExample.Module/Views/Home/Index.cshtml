@using CrestApps.OrchardCore.SignalR.Core.Services
@using OrchardExample.Module
@inject HubRouteManager HubRouteManager

@{
  var url = HubRouteManager.GetUriByHub<PingHub>(ViewContext.HttpContext);
}

<script asp-name="signalr" script at="Head"></script>

<script at="Head">
  document.addEventListener("DOMContentLoaded", function () {
    var connection = new signalR.HubConnectionBuilder()
      .withUrl("@url")
      .build();

    async function startConnection() {
      try {
        await connection.start();
        console.log(`connected with connectionId: ${connection.connectionId}`);
      } catch (error) {
        console.error('Connection failed:', error.message);
      }
    }

    startConnection();

  });
</script>
