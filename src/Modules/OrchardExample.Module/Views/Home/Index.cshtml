@using CrestApps.OrchardCore.SignalR.Core.Services
@using OrchardExample.Module
@inject HubRouteManager HubRouteManager

@{
  var url = HubRouteManager.GetUriByHub<PingHub>(ViewContext.HttpContext);
}

<script type="text/javascript" at="Foot" depends-on="signalr">

  document.addEventListener("DOMContentLoaded", function () {
    var connection = new signalR.HubConnectionBuilder()
      .withUrl("@url")
      .build();

    async function startConnection() {
      try {
        await connection.start();
        console.log('Connected to SignalR hub!');
      } catch (error) {
        console.error('Connection failed:', error.message);
      }
    }

    startConnection();

  });
</script>
